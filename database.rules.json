{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.length >= 12",
        ".write": "$code.length >= 12",
        ".validate": "newData.hasChildren(['t','s']) && newData.child('s').isString() && newData.child('s').val().length < 900000"
      }
    }
  }
}